@page "/design/LogGroupComponent"
@using DoneIt.DailyLogs.Data

<section class="log-group">

	<header class="group-header">

		<div class="group-title">
			<span class="group-dot group-dot-project"></span>

			<h2 class="editable editable-title"
				contenteditable="true"
				spellcheck="false">
				@_logGroupEntry.Title
			</h2>
		</div>

		<div class="group-actions">

			<button class="sync-status sync-status-synced"
					type="button"
					aria-label="Synced"
					title="Synced">
				✓
			</button>

			<button class="sync-status sync-status-syncing"
					type="button"
					aria-label="Syncing"
					title="Syncing">
				<svg class="sync-status-icon"
					 viewBox="0 0 24 24"
					 aria-hidden="true">
					<path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"></path>
					<path d="M21 3v5h-5"></path>
				</svg>
			</button>

			<button class="sync-status sync-status-error"
					type="button"
					aria-label="Sync error"
					title="Sync error">
				!
			</button>

			<button class="group-menu"
					type="button"
					aria-label="Group options">
				•••
			</button>

		</div>

	</header>

	<div class="group-entry-list">

		@foreach (LogEntry logEntry in _logGroupEntry.LogEntries)
		{
			<article class="group-entry">

				<label class="entry-time-field">
					<svg class="entry-time-icon" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="9"></circle>
						<path d="M12 7v5l3 2"></path>
					</svg>
					<input class="entry-time"
						   type="time"
						   value="@logEntry.Timestamp.ToString("HH:mm")"
						   aria-label="Entry time">
				</label>

				<div class="entry-content editable"
					 contenteditable="true"
					 role="textbox"
					 aria-multiline="true"
					 spellcheck="true">
					@logEntry.Content
				</div>

			</article>
		}
	<article class="group-entry">
		<label class="entry-time-field">
			<svg class="entry-time-icon" viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 7v5l3 2"></path>
			</svg>
			<input class="entry-time"
				   type="time"
				   value="09:15"
				   aria-label="Entry time">
		</label>
		<div class="entry-content editable"
			 contenteditable="true"
			 role="textbox"
			 aria-multiline="true"
			 spellcheck="true">
			Discussed API changes with <span class="mention">tag:John</span>.<br>
			We need to update the authentication flow to support SSO.<br>
			Add <span class="inline-task"
				  contenteditable="false"
				  role="checkbox"
				  aria-checked="false"
				  tabindex="0">
			<span class="inline-task-check" aria-hidden="true"></span>
			<span>Review new API spec</span>
		</span> before release <span class="tag">#backend</span>
	</div>
</article>

<article class="group-entry">

	<label class="entry-time-field">
		<svg class="entry-time-icon" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M12 7v5l3 2"></path>
		</svg>
		<input class="entry-time"
			   type="time"
			   value="11:30"
			   aria-label="Entry time">
	</label>

	<div class="entry-content editable"
		 contenteditable="true"
		 role="textbox"
		 aria-multiline="true"
		 spellcheck="true">
		Frontend sync — dashboard components are almost done.<br>
		<span class="mention">tag:Sara</span> will push the last changes.<br>
		Completed <span class="inline-task is-complete"
					contenteditable="false"
					role="checkbox"
					aria-checked="true"
					tabindex="0">
		<span class="inline-task-check" aria-hidden="true"></span>
		<span>Test collapsible sidebar</span>
	</span> for <span class="tag">#frontend</span>
</div>

</article>

<article class="group-entry empty-entry">

	<label class="entry-time-field">
		<svg class="entry-time-icon" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M12 7v5l3 2"></path>
		</svg>
		<input class="entry-time"
			   type="time"
			   value="16:20"
			   aria-label="Entry time">
	</label>

	<div class="entry-content empty-entry-input editable is-empty"
		 contenteditable="true"
		 role="textbox"
		 aria-multiline="true"
		 spellcheck="true">
	</div>

</article>

</div>

</section>

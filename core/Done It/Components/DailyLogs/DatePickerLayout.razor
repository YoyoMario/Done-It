<section class="date-picker" aria-label="Choose daily log date">
    <header class="date-picker-header">
        <button class="date-picker-navigation"
                type="button"
                aria-label="Previous month"
                @onclick="ShowPreviousMonth">
            ‹
        </button>

        <h2 class="date-picker-month">@VisibleMonthLabel</h2>

        <button class="date-picker-navigation"
                type="button"
                aria-label="Next month"
                @onclick="ShowNextMonth">
            ›
        </button>
    </header>

    <div class="date-picker-weekdays" aria-hidden="true">
        @foreach (string weekday in Weekdays)
        {
            <span>@weekday</span>
        }
    </div>

    <div class="date-picker-days">
        @foreach (DateOnly? date in CalendarDays)
        {
            if (date is null)
            {
                <span class="date-picker-day-placeholder"></span>
            }
            else
            {
                <button class="@GetDayClass(date.Value)"
                        type="button"
                        aria-label="@date.Value.ToString("D")"
                        aria-pressed="@(date.Value == CurrentSelection)"
                        @onclick="() => SelectDateAsync(date.Value)">
                    @date.Value.Day
                </button>
            }
        }
    </div>
</section>

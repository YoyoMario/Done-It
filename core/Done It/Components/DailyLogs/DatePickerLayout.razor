<header class="daily-log-header">
    <div class="daily-log-heading">
        <h1 class="daily-log-title">Daily Log</h1>
        <p class="daily-log-date">
            <time datetime="@(SelectedDate.ToString("yyyy-MM-dd"))">
                @FormattedDate
            </time>
        </p>
    </div>

    <div class="daily-log-actions" aria-label="Daily log actions">
        @* Date controls can be introduced here later. *@
    </div>
</header>
